# 复制为 .env 后填写；.env 不要提交到仓库
# 数据库 root 密码（仅容器内部与备份使用）
MYSQL_ROOT_PASSWORD=change-me-root-密码
# 应用连接数据库使用的账号密码
MYSQL_PASSWORD=change-me-app-密码
# JWT 签名密钥，HS256 要求至少 32 字节
JWT_SECRET=change-me-campus-market-jwt-secret-32bytes-min
# 对外暴露的 HTTP 端口
WEB_PORT=8080
# 可选：允许跨域的前端地址，逗号分隔。默认只允许本地开发地址；
# 用独立域名访问前端（非 Nginx 同源代理）时在此追加，例如 https://market.example.edu.cn
# CORS_ALLOWED_ORIGINS=https://market.example.edu.cn
